{
  "name": "bible-cross-references",
  "version": "0.1.0",
  "private": true,
  "description": "A minimalist, interactive explorer of Bible cross-references.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run data:build && vite",
    "build": "npm run data:build && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "typecoverage": "node scripts/type-coverage.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:built": "vitest run scripts/data/built-datasets.test.ts",
    "test:e2e": "playwright test --project=desktop --project=phone --project=offline",
    "test:e2e:ci": "CI=1 playwright test --project=desktop --project=phone --project=offline",
    "test:visual": "playwright test --project=visual-desktop --project=visual-phone",
    "test:visual:update": "npm run test:visual -- --update-snapshots",
    "test:report": "playwright show-report",
    "check": "npm run typecheck && npm run typecoverage && npm run lint && npm run format:check && npm run test:coverage",
    "data": "npm run data:fetch && npm run data:build",
    "data:fetch": "node scripts/data/fetch.ts",
    "data:build": "node scripts/data/build.ts",
    "locale:new": "node scripts/locale/new.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "globals": "^17.12.0",
    "happy-dom": "^20.0.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
